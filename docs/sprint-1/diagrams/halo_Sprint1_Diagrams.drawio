<diagram id="fsml1login" name="FSM L1 - Log In"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Finite State Machine Level 1 - Log In System" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=26;fontColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="350.0" y="-60" width="800" height="40" as="geometry"/></mxCell><mxCell id="c2" value="" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fillColor=#FFFFFF;strokeColor=#B85450;fontSize=14;fontColor=#000000;fontStyle=0;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="15" y="60" width="1470" height="740" as="geometry"/></mxCell><mxCell id="c3" value="Log In" style="swimlane;html=1;startSize=34;fontFamily=Helvetica;fontSize=16;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="260" y="140" width="980" height="610" as="geometry"/></mxCell><mxCell id="c4" value="User Input" style="swimlane;html=1;whiteSpace=wrap;startSize=30;fontFamily=Helvetica;fontSize=15;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="450" y="220" width="600" height="167" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style=&quot;margin-bottom:9px&quot;&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Entry/&lt;/b&gt;&lt;/font&gt; Click logIn() from &quot;Welcome&quot; state, logIn() != Success || failedAttempts &amp;lt; 3 from &quot;Verify Log In&quot; state, backToLogIn() from &quot;Forgot Password&quot; state, createAccount() == Success or logIn() from &quot;Create Account&quot; state&lt;/div&gt;&lt;div style=&quot;margin-bottom:9px&quot;&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Do/&lt;/b&gt;&lt;/font&gt; Wait for email and password from user&lt;/div&gt;&lt;div style=&quot;margin-bottom:0px&quot;&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Exit/&lt;/b&gt;&lt;/font&gt; Click verifyLogIn() to &quot;Verify Log In&quot; state, forgotPassword() to &quot;Forgot Password&quot;, createAccount() to &quot;Create Account&quot;, Back() to &quot;Welcome&quot; state&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1" parent="c4"><mxGeometry x="6" y="34" width="588" height="129" as="geometry"/></mxCell><mxCell id="c6" value="Verify Log In" style="swimlane;html=1;whiteSpace=wrap;startSize=30;fontFamily=Helvetica;fontSize=15;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="450" y="527" width="600" height="133" as="geometry"/></mxCell><mxCell id="c7" value="&lt;div style=&quot;margin-bottom:9px&quot;&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Entry/&lt;/b&gt;&lt;/font&gt; Click verifyLogIn() from &quot;User Input&quot; state&lt;/div&gt;&lt;div style=&quot;margin-bottom:9px&quot;&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Do/&lt;/b&gt;&lt;/font&gt; Check the email and password with the database&lt;/div&gt;&lt;div style=&quot;margin-bottom:0px&quot;&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Exit/&lt;/b&gt;&lt;/font&gt; logIn() != Success || failedAttempts &amp;lt; 3 to &quot;User Input&quot; state, failedAttempts == 3 to &quot;Forgot Password&quot;, logIn() == Success to &quot;Home&quot; state&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1" parent="c6"><mxGeometry x="6" y="34" width="588" height="95" as="geometry"/></mxCell><mxCell id="c8" value="logIn() from Welcome" style="edgeStyle=none;rounded=0;html=1;fo