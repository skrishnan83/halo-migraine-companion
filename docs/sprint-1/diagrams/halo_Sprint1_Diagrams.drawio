&quot; state&lt;/div&gt;&lt;div style=&quot;margin-bottom:9px&quot;&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Do/&lt;/b&gt;&lt;/font&gt; Show the halo logo for about 2.5 seconds&lt;/div&gt;&lt;div style=&quot;margin-bottom:0px&quot;&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Exit/&lt;/b&gt;&lt;/font&gt; Go to &quot;Welcome&quot; state&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1" parent="c5"><mxGeometry x="6" y="34" width="348" height="95" as="geometry"/></mxCell><mxCell id="c7" value="Welcome" style="swimlane;html=1;whiteSpace=wrap;startSize=30;fontFamily=Helvetica;fontSize=15;fontStyle=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="675" y="303" width="400" height="167" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style=&quot;margin-bottom:9px&quot;&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Entry/&lt;/b&gt;&lt;/font&gt; After the splash, Back() from &quot;Log In&quot;, &quot;Create Account&quot; or &quot;About halo&quot; state&lt;/div&gt;&lt;div style=&quot;margin-bottom:9px&quot;&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Do/&lt;/b&gt;&lt;/font&gt; Display Log In, Create Account and About halo&lt;/div&gt;&lt;div style=&quot;margin-bottom:0px&quot;&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Exit/&lt;/b&gt;&lt;/font&gt; Click logIn() to &quot;Log In&quot; state, createAccount() to &quot;Create Account&quot; state, aboutHalo() to &quot;About halo&quot; state or Close Application&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1" parent="c7"><mxGeometry x="6" y="34" width="388" height="129" as="geometry"/></mxCell><mxCell id="c9" value="Log In" style="swimlane;html=1;whiteSpace=wrap;startSize=30;fontFamily=Helvetica;fontSize=15;fontStyle=1;fillColor=#D5E8D4;strokeColor=#82B366;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="110" y="600" width="400" height="217" as="geometry"/></mxCell><mxCell id="c10" value="&lt;div style=&quot;margin-bottom:9px&quot;&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Entry/&lt;/b&gt;&lt;/font&gt; Click logIn() from &quot;Welcome&quot; state, createAccount() == Success or logIn() from &quot;Create Account&quot; state, logIn() != Success || failedAttempts &amp;lt; 3 from &quot;Log In&quot; state, backToLogIn() from &quot;Forgot Password&quot; state&lt;/div&gt;&lt;div style=&quot;margin-bottom:9px&quot;&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Do/&lt;/b&gt;&lt;/font&gt; Wait for email and password from user&lt;/div&gt;&lt;div style=&quot;margin-bottom:0px&quot;&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Exit/&lt;/b&gt;&lt;/font&gt; logIn() == Success to &quot;Home&quot; state, forgotPassword() || failedAttempts == 3 to &quot;Forgot Password&quot; state, createAccount() to &quot;Create Account&quot; state, Back() or Close Application&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Helvetica;fontSize=14;fontColor=#000000;fontStyle=0;" vertex="1" parent="c9"><mxGeometry x="6" y="34" width="388" height="179" as="geometry"/></mxCell><mxCell id="c11" value="Create Account" style="swimlane;html=1;whiteSpace=wrap;startSize=30;fontFamily=Helvetica;fontSize=15;fontStyle=1;fillColor=#E1D5E7;strokeColor=#9673A6;swimlaneFillColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="720" y="600" width="400" height="184" as="geometry"/></mxCell><mxCell id="c12" value="&lt;div style=&quot;margin-bottom:9px&quot;&gt;&lt;font color=&quot;#CC0000&quot;&gt;&lt;b&gt;Entry/&lt;/b&gt;&lt;/font&gt; Click createAccount() from &quot;Welcome&quot; or &quot;Log In&quot; state, createAccount() != Success from &quot;Create Account&quot; state&lt;/div&gt;&lt;di